# Chat 模型：openai | openai-compatible | google
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI-compatible Chat 示例（启用时将 AI_PROVIDER 改为 openai-compatible）
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_BASE_URL=https://your-provider.example/v1

AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=60000

# PostgreSQL + pgvector。本地 Compose 默认值与此一致。
DATABASE_URL=postgresql://ting_lab:change-me@localhost:5432/ting_lab
DATABASE_POOL_MAX=5
POSTGRES_DB=ting_lab
POSTGRES_USER=ting_lab
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Embedding 独立于 Chat，仅支持 openai | openai-compatible。
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=

# OpenAI-compatible Embedding 必须显式提供 Base URL。
# EMBEDDING_BASE_URL=https://your-provider.example/v1

EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHARS=12000

# 仅当可信反向代理会覆盖客户端传入的 x-forwarded-for 时启用。
TRUST_PROXY=false

# Independent media database; initialize roles before switching DATABASE_URL.
BLOG_DB_USER=ting_blog
BLOG_DB_PASSWORD=replace-with-blog-runtime-password
MEDIA_DB_NAME=ting_media
MEDIA_DB_USER=ting_media
MEDIA_DB_PASSWORD=replace-with-media-runtime-password
MEDIA_DATABASE_URL=postgresql://ting_media:replace-with-media-runtime-password@127.0.0.1:5432/ting_media
MEDIA_SERVICE_URL=http://127.0.0.1:3100
MEDIA_SERVICE_TOKEN=replace-with-independent-media-service-token
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=20000000
MEDIA_CONCURRENCY=1
MEDIA_TIMEOUT_MS=30000
