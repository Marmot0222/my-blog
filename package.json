{
  "name": "ting-lab",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "content:check": "pnpm --filter @ting-lab/content content:check ../../content",
    "content:index": "pnpm --filter @ting-lab/publishing exec tsx --env-file-if-exists=../../apps/web/.env.local src/cli.ts index",
    "content:search": "pnpm --filter @ting-lab/publishing exec tsx --env-file-if-exists=../../apps/web/.env.local src/cli.ts search",
    "db:up": "docker compose --env-file apps/web/.env.local -f compose.dev.yml up -d",
    "db:down": "docker compose --env-file apps/web/.env.local -f compose.dev.yml down",
    "db:generate": "pnpm --filter @ting-lab/database db:generate",
    "db:migrate": "pnpm --filter @ting-lab/database db:migrate",
    "db:check": "pnpm --filter @ting-lab/database db:check",
    "deploy:prod": "bash ./scripts/deploy.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "content:new": "pnpm --filter @ting-lab/content content:new",
    "content:import": "pnpm --filter @ting-lab/publishing exec tsx --env-file-if-exists=../../apps/web/.env.local src/cli.ts import",
    "admin:password": "pnpm --filter @ting-lab/publishing exec tsx --env-file-if-exists=../../apps/web/.env.local src/cli.ts password",
    "admin:secrets": "pnpm --filter @ting-lab/publishing exec tsx src/cli.ts secrets",
    "worker": "pnpm --filter @ting-lab/publishing exec tsx --env-file-if-exists=../../apps/web/.env.local src/worker.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.1",
    "prettier": "^3.6.2",
    "sass": "1.101.0",
    "turbo": "^2.5.8"
  }
}
