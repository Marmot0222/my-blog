{
  "name": "@ting-lab/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kinds": {
      "types": "./src/kinds.ts",
      "default": "./src/kinds.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "content:check": "tsx src/check.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/posts.test.ts src/projects.test.ts src/search.test.ts src/workflow.test.ts src/markdown.test.ts src/media.test.ts",
    "content:new": "tsx src/new.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "reading-time": "^1.5.0",
    "zod": "^3.25.76",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@ting-lab/eslint-config": "workspace:*",
    "@ting-lab/typescript-config": "workspace:*",
    "eslint": "^9.29.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
