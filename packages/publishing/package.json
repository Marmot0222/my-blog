{
  "name": "@ting-lab/publishing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/*.test.ts",
    "admin:password": "tsx src/cli.ts password",
    "content:import": "tsx src/cli.ts import",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@ting-lab/content": "workspace:*",
    "@ting-lab/database": "workspace:*",
    "@ting-lab/ai": "workspace:*",
    "@ting-lab/retrieval": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ting-lab/typescript-config": "workspace:*",
    "@ting-lab/eslint-config": "workspace:*",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "tsx": "^4.23.1"
  }
}
